// === Test 1: 50-case round-down-in-vault-favor invariant ===

/// Round-down-in-vault-favor across 50 deterministic cases.
///
/// The formula `(deposit * (total_shares + virtual_shares)) /
/// (total_assets + 1)` truncates toward zero, which rounds DOWN — vault's
/// favor (Pitfall 12). The +1 in the denominator is a second
/// vault-favor lever (it can only ever decrease the result vs a `+0`
/// denominator). The Python expected-floor pre-computed at generation
/// time is the exact integer truncation of the same formula; we assert
/// bit-equality.
#[test]
fun compute_shares_to_mint_rounds_down_in_vault_favor_50_random_cases() {
    let cases = random_cases();
    let n = vector::length(&cases);
    let mut i = 0;
    while (i < n) {
        let case = vector::borrow(&cases, i);
        let deposit = *vector::borrow(case, 0);
        let total_assets = *vector::borrow(case, 1);
        let total_shares = *vector::borrow(case, 2);
        let expected = *vector::borrow(case, 3);

        let actual = supply::compute_shares_to_mint_for_test(
            total_assets,
            total_shares,
            deposit,
        );
        assert_eq!(actual, expected);
        i = i + 1;
    };
}

// === Test 2: redeem_request -> fulfill payout bound (W5 LOCK) ===

/// W5 LOCK — full request/fulfill flow with payout bound assertions.
///
/// Setup:
///   - new_seeded_vault: total_assets = 10M, total_shares = 1M (virtual,
///     burned to @0xdead), balance = 10M.
///   - test_mint_shares_to(user, 100_000): total_shares = 1_100_000;
///     user holds 100k SHARE.
///   - inflate_liquid_for_testing(1_000_000): balance = 11M,
///     total_assets = 11M.
///
/// NAV per share = 11_000_000 * 1e9 / 1_100_000 = 10_000_000_000
///                = 10 quote per share at 1e9 fixed-point.
/// pro_rata for 100_000 shares = 100_000 * 10e9 / 1e9 = 1_000_000.
/// expected_payout = 1_000_000 micro-DUSDC.
///
/// Bucket capacity (100_000_000) and liquid balance (11_000_000) both
/// dwarf pro_rata so the payout equals expected_payout exactly. The
/// `<= expected_payout` form is robust to alternative bucket / balance
/// settings.
///
/// Liquidity bound: actual_payout <= seed_amt + extra_balance =
///                  10_000_000 + 1_000_000 = 11_000_000.
#[test]
fun redeem_request_then_fulfill_returns_at_most_proportional_NAV() {
    let mut scenario = ts::begin(ADMIN);
    let (mut vault, admin_cap, mut clk) = new_seeded_vault(&mut scenario);

    let seed_amt = strategy_constants::seed_quote_micro_units();
    let user_share_amount: u64 = 100_000;
    let user_quote_deposit: u64 = 1_000_000;

    // Mint 100_000 shares directly to USER (W5 helper test_mint_shares_to).
    vault::test_mint_shares_to<TEST_QUOTE>(
        &mut vault,
        USER,
        user_share_amount,
        scenario.ctx(),
    );

    // Inflate liquid balance + total_assets by 1_000_000 micro-DUSDC.
    let extra = coin::mint_for_testing<TEST_QUOTE>(user_quote_deposit, scenario.ctx());
    vault::inflate_liquid_for_testing<TEST_QUOTE>(&mut vault, extra);

    // expected_payout = 100_000 * (10_000_000 + 1_000_000) / (1_000_000 + 100_000)
    //                 = 100_000 * 11_000_000 / 1_100_000
    //                 = 1_000_000 micro-DUSDC.
    let expected_payout: u64 = 1_000_000;

    // Switch to USER and pick up the SHARE coin transferred via test_mint_shares_to.
    scenario.next_tx(USER);
    let user_shares = scenario.take_from_sender<Coin<SHARE>>();
    assert_eq!(coin::value(&user_shares), user_share_amount);

    // Step 1: redeem_request escrows shares + records timestamp at t=0.
    clk.set_for_testing(0);
    redeem::redeem_request<TEST_QUOTE>(&mut vault, user_shares, &clk, scenario.ctx());

    // Step 2: warp clock past the 1h cooldown.
    clk.increment_for_testing(COOLDOWN_PLUS_1MS);

    // Step 3: redeem_fulfill — pays out min(pro_rata, bucket_avail, liquid).
    redeem::redeem_fulfill<TEST_QUOTE>(&mut vault, &clk, scenario.ctx());

    // Capture payout Coin<TEST_QUOTE>.
    scenario.next_tx(USER);
    let payout_coin = scenario.take_from_sender<Coin<TEST_QUOTE>>();
    let actual_payout = coin::value(&payout_coin);

    // W5 assertions (both bounds enforced):
    //   (a) Round-down-in-vault-favor: actual_payout <= expected_payout.
    //   (b) Liquidity bound: actual_payout <= seed + extra_balance.
    assert!(actual_payout <= expected_payout, 9001);
    assert!(actual_payout <= (seed_amt + user_quote_deposit), 9002);

    destroy(payout_coin);
    cleanup(vault, admin_cap, clk);
    scenario.end();
}

// === Test 3: seed-once invariant ===

/// Seed-once invariant: the SHARE module's `init_for_testing` produces
/// exactly one PendingTreasury, which `consume_pending` consumes by
/// value. After consumption, no second PendingTreasury exists in the
/// deployer's inventory — Sui's type system enforces this structurally.
///
/// The production `vault::create_vault` further wraps consume_pending
/// behind a `seed.value() == seed_quote_micro_units()` assert, so the
/// only path that mints virtual_shares + burns them to @0xdead is
/// gated by both the type system AND the seed-amount check. This test
/// confirms the type-level half: a second create_vault call with the
/// SAME PendingTreasury cannot type-check.
#[test]
fun create_vault_seed_transaction_succeeds_once() {
    let mut scenario = ts::begin(ADMIN);

    // First seed: init mints one PendingTreasury to ADMIN's inventory.
    share::init_for_testing(scenario.ctx());
    scenario.next_tx(ADMIN);
    let pending = scenario.take_from_sender<share::PendingTreasury>();

    // Consume it via the public(package) accessor (the same path
    // create_vault uses internally). After this returns, the
    // PendingTreasury is destroyed by value — no second instance exists.
    let cap = share::consume_pending(pending);

    // Assert: ADMIN's inventory no longer contains a PendingTreasury.
    // The Move type system makes a second `take_from_sender<PendingTreasury>`
    // call a runtime error (the test framework returns false from
    // `has_most_recent_for_sender` once the object is consumed).
    scenario.next_tx(ADMIN);
    assert_eq!(
        ts::has_most_recent_for_sender<share::PendingTreasury>(&scenario),
        false,
    );

    // Cleanup: destroy the cap so the test scenario closes cleanly.
    destroy(cap);
    scenario.end();
}
