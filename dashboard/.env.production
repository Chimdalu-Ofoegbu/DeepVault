# dashboard/.env.production — committed PUBLIC build-time config for the
# hosted (Vercel) deployment. Loaded automatically by `vite build`
# (mode=production). Every VITE_* var is inlined into the client bundle, so
# NONE of these are secrets — they are the public testnet demo endpoints.
#
# Local dev uses dashboard/.env.local (gitignored) which points at
# ws://localhost:8080. This file is what the live judge-facing build uses.

# DeepVault event relay (Render free-tier web service, Oregon region).
# Root path — the relay's ws upgrade handler accepts any path (wsServer.ts).
VITE_RELAY_WS_URL=wss://deepvault-relay.onrender.com

# Sui network the on-chain reads + explorer links target.
VITE_SUI_NETWORK=testnet

# Mysten's public Predict indexer (vault utilization / per-oracle exposure reads).
VITE_PREDICT_SERVER_URL=https://predict-server.testnet.mystenlabs.com
