# Sui testnet RPC (default falls back via getFullnodeUrl)
SUI_RPC_URL=https://fullnode.testnet.sui.io
# Path to TESTNET-DEPLOY.json (resolved relative to repo root)
DEPLOY_JSON_PATH=.planning/phases/02-vault-move-package-testnet-deploy/TESTNET-DEPLOY.json
# WebSocket port (Render auto-proxies to wss://<svc>.onrender.com)
PORT=8080
# Log level (pino): trace, debug, info, warn, error
LOG_LEVEL=info
# Optional override (Plan 02 reads from TESTNET-DEPLOY.json by default)
ORACLE_SVI_ID=
